<TcPlcObject Version="1.1.0.1">
  <DUT Name="E_ServoliftStatus" Id="{ece8c7ae-af6d-402f-b7e8-c15138adb032}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE E_ServoliftStatus :
(
	Idle := 0, // De servolift staat stil en voert geen actie uit
	Omhoogbewegen, // De servolift is aan het omhoog bewegen
	Omlaagbewegen, // De servolift is aan het omlaag bewegen
	Vasthouden, // De servolift is zijn positie aan het vasthouden
	Error // Er is een fout opgetreden
);
END_TYPE
]]></Declaration>
  </DUT>
