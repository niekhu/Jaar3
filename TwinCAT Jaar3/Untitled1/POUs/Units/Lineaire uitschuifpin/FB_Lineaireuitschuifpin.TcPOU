      </Get>
    </Property>
    <Property Name="Uitschuiven" Id="{6f1245d3-703d-49e6-b5c3-fc9f7e845239}" FolderPath="Properties\">
      <Declaration><![CDATA[PROPERTY Uitschuiven : BOOL
]]></Declaration>
      <Get Name="Get" Id="{f7b9b1a6-5888-427a-afcf-65bb1aae2110}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Uitschuiven := Uitschuiven_Intern;]]></ST>
        </Implementation>
      </Get>
