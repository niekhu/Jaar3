        <Declaration><![CDATA[VAR
	Waarde : BOOL;
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Inschuiven_Intern := Waarde; ]]></ST>
        </Implementation>
      </Set>
