    <Property Name="Status" Id="{cb8204f7-4950-4a8c-8934-597798037ced}" FolderPath="Properties\">
      <Declaration><![CDATA[PROPERTY Status : E_LineaireactuatoruitschuifpinnenStatus
]]></Declaration>
      <Get Name="Get" Id="{69e69824-d7d1-4e68-9749-08fcefec1925}">
