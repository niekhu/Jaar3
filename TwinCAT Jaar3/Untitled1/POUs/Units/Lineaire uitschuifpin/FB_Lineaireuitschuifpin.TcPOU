    <Method Name="Update" Id="{2e73f703-d45a-4545-a444-69799cb78195}" FolderPath="Methods\">
      <Declaration><![CDATA[METHOD Update : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Sensorstatus opslaan
Uitgeschoven_Intern := Sensor_uitgeschoven;
Ingeschoven_Intern := Sensor_ingeschoven; 

// Standaard outputs
Uitschuiven_output := FALSE; 
Inschuiven_output := FALSE; 

// Fout resetten
IF Error_Intern AND (NOT Uitschuiven_Intern) AND (Inschuiven_Intern) THEN
	Error_Intern := FALSE;
END_IF

// Status van de lineaire actuator met uitschuif pinnen
CASE Status_Intern OF 
	
	E_LineaireactuatoruitschuifpinnenStatus.Idle:
		IF Uitschuiven_Intern THEN
			Status_Intern := E_LineaireactuatoruitschuifpinnenStatus.Uitschuiven;
			MotionTimeout(IN := TRUE, PT := T#3S);
		ELSIF Inschuiven_Intern THEN
			Status_Intern := E_LineaireactuatoruitschuifpinnenStatus.Inschuiven;
			MotionTimeout(IN := TRUE, PT := T#3S);
		END_IF
	
	E_LineaireactuatoruitschuifpinnenStatus.Uitschuiven:
		Uitschuiven_output := TRUE; 
		
		IF Uitgeschoven_Intern THEN
			Status_Intern := E_LineaireactuatoruitschuifpinnenStatus.Uitgeschoven;
			MotionTimeout(IN := FALSE);
		ELSIF MotionTimeout.Q THEN
			Status_Intern := E_LineaireactuatoruitschuifpinnenStatus.Error;
			Error_Intern := TRUE;
		END_IF
	
	E_LineaireactuatoruitschuifpinnenStatus.Inschuiven:
		Inschuiven_output := TRUE;
		
		IF Ingeschoven_Intern THEN
			Status_Intern := E_LineaireactuatoruitschuifpinnenStatus.Ingeschoven;
			MotionTimeout(IN := FALSE);
		ELSIF MotionTimeout.Q THEN
			Status_Intern := E_LineaireactuatoruitschuifpinnenStatus.Error;
			Error_Intern := TRUE;
		END_IF
	
	E_LineaireactuatoruitschuifpinnenStatus.Uitgeschoven:
		IF Inschuiven_Intern THEN
			Status_Intern := E_LineaireactuatoruitschuifpinnenStatus.Inschuiven;
			MotionTimeout(IN := TRUE, PT := T#3S;
		END_IF
	
	E_LineaireactuatoruitschuifpinnenStatus.Ingeschoven:
		IF Uitschuiven_Intern THEN
			Status_Intern := E_LineaireactuatoruitschuifpinnenStatus.Uitschuiven;
			MotionTimeout(IN := TRUE, PT := T#3S;
		END_IF
	
	E_LineaireactuatoruitschuifpinnenStatus.Error:
		Uitschuiven_output := FALSE; 
		Inschuiven_output := FALSE; 
END_CASE]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>