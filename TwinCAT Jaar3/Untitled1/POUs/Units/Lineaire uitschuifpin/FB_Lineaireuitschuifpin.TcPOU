<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_Lineaireuitschuifpin" Id="{3aed7838-cf13-43b5-9856-d0a4446344f2}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_Lineaireuitschuifpin IMPLEMENTS ITF_Lineaireuitschuifpin
VAR_INPUT
	// Sensoren van de cilinders of ze zijn uitgeschoven of ingeschoven
	Sensor_uitgeschoven : BOOL; // Terugmelding cilinder met pin is uitgeschoven
	Sensor_ingeschoven : BOOL; // Terugmelding cilinder met pin is ingeschoven
END_VAR

VAR_OUTPUT
	// Fysieke uitgangen aan de ventielen
	Uitschuiven_output : BOOL; 
	Inschuiven_output : BOOL;
END_VAR

VAR
	// Interne variabelen
	Uitschuiven_Intern : BOOL; 
	Inschuiven_Intern : BOOL; 
	
	Status_Intern : E_LineaireactuatoruitschuifpinnenStatus;
	Uitgeschoven_Intern : BOOL; 
	Ingeschoven_Intern : BOOL; 
	Error_Intern : BOOL;
	
	// Timer voor foutdetectie
	MotionTimeout : TON; 
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
