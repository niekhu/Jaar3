    <Method Name="Execute" Id="{7bc828e8-56fb-4ceb-956d-11c06042b4fa}" FolderPath="Methods\">
      <Declaration><![CDATA[METHOD Execute : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//LET OP ik wist niet welke units terugmeldingen hebben dus evt moet je checks toevoegen
CurrentStateDep := E_PackMLStates.Execute;
CASE Step OF


// Wachten tot een pallet binnenkomt

0:
    IF InputPalletVanafBufADep AND NOT DepalletPalletBinnen THEN		//check of er pallet klaarstaat en er nog geen pallet in depallet is
        RolbandAanUit := TRUE;			// rolband aan
		KlaarVoorInvoerDep := TRUE;
        Step := 10;
    END_IF
	IF NOT InputPalletVanafBufADep AND NOT DepalletPalletBinnen THEN
		TriggerState := E_PackMLStates.Suspending;
	END_IF


// Lichtsensor ziet pallet

10:
    IF LichtsensorDetectYesNo THEN
        KlepDepalletEind.SturingOpen(TRUE);
        TimerExtra(IN := TRUE, PT := T#10S);
        Step := 20;
    END_IF


// Wachten op timer en check lagen omdat code bij elke laag vanaf hier opnieuw begint

20:
    IF TimerExtra.Q THEN
        IF AantalLagenVerwijderd < AantalLagenBlikjesTotaal THEN
            RolbandAanUit := FALSE;			//rolband uit
            DepalletPalletBinnen := TRUE;
			KlaarVoorInvoerDep := FALSE;
            PinnenUitYesNo := TRUE;			//vasthouden pallet in lift (pinnen uit)
            LiftBewegingYesNo := TRUE;   // lift omhoog
            Step := 30;
        ELSE
            // Alle lagen verwijderd 
            Step := 200;
        END_IF
    END_IF


// Wachten tot lift op hoogte is

30:
    IF AfstandssensorDetectYesNo THEN			//afstandssensor detecteert
        LiftBewegingYesNo := FALSE;	//lift stil
        ZuigBenedenBoven := TRUE;  // zuignappen omlaag op karton
        Step := 40;
    END_IF


// Wachten tot zuignappen beneden zijn

40:
    IF ZuigBenedenAangekomen THEN			//terugmelding dat zuignappen beneden zijn
        Zuignap1.Oppakken();				
        Zuignap2.Oppakken();
        Zuignap3.Oppakken();
        Zuignap4.Oppakken();
        Step := 50;
    END_IF


// Check of alle zuignappen vacuum hebben

50:
    IF  Zuignap1.Status = E_VacuumzuignapStatus.SturingVacuumOpppakken AND
        Zuignap2.Status = E_VacuumzuignapStatus.SturingVacuumOpppakken AND
        Zuignap3.Status = E_VacuumzuignapStatus.SturingVacuumOpppakken AND
        Zuignap4.Status = E_VacuumzuignapStatus.SturingVacuumOpppakken AND
        Druksensor1.Druk >= MinimaleDrukZuignappen THEN
        
        ZuigBenedenBoven := FALSE;    // zuignappen omhoog
        Step := 60;
    END_IF


// Wachten tot zuigunit boven is

60:
    IF  ZuigBovenAangekomen THEN		//terugmelding zuignappen zijn omhoog
		Step := 70;
        MotorZuig.SturingLang(); // uitschuiven van de motor zodat karton naar kartonopslag gaat
        Step := 70;
    END_IF


// Wachten tot schuif lang staat en karton loslaten

70:
    IF MotorZuig.Status = E_MotorZuigSchuifStatus.Lang THEN
        Zuignap1.Loslaten();
        Zuignap2.Loslaten();
        Zuignap3.Loslaten();
        Zuignap4.Loslaten();
        Step := 80;
    END_IF



// Check of alles los is en schuif terug

80:
    IF  Zuignap1.Status = E_VacuumzuignapStatus.SturingVacuumLoslaten AND
        Zuignap2.Status = E_VacuumzuignapStatus.SturingVacuumLoslaten AND
        Zuignap3.Status = E_VacuumzuignapStatus.SturingVacuumLoslaten AND
        Zuignap4.Status = E_VacuumzuignapStatus.SturingVacuumLoslaten THEN

        MotorZuig.SturingKort();  // schuif terug
        Step := 90;
    END_IF


// Wachten tot schuif terug is en check of blikjes band niet vol staat

90:
    IF MotorZuig.Status = E_MotorZuigSchuifStatus.Kort AND NOT SensorBlikjesOpBandYesNo THEN  
        MotorSchuif.SturingLang(); // blikjes op band schuiven
        Step := 100;
    END_IF



// Wachten tot MotorSchuif lang staat

100:
    IF MotorSchuif.Status = E_MotorZuigSchuifStatus.Lang THEN
        MotorSchuif.SturingKort();
        Step := 110;
    END_IF



// Wachten tot MotorSchuif terug is

110:
    IF MotorSchuif.Status = E_MotorZuigSchuifStatus.Kort AND joejoe = TRUE THEN
        AantalLagenVerwijderd := AantalLagenVerwijderd + 1;
        Step := 20;    // Ga terug naar stap 20 voor volgende laag
		RETURN;
    END_IF





// Vanaf deze stap als alle lagen blikjes van pallet zijn verwijderd

200:
    LiftBewegingYesNo := TRUE;      // lift omlaag

    IF EindLiftBeneden THEN				//eindschakelaar lift beneden
        LiftBewegingYesNo := FALSE;		//lift stil
        KlepDepalletEind.SturingOpen(FALSE);		//klep omlaag
        Step := 210;
    END_IF



// Pallet naar uitgang rijden

210:
    IF NOT InputPalletBijUitgang THEN		//controle of er een pallet voor de uitgang staat
        RolbandAanUit := TRUE;				//rolband aan
		KlaarVoorUitvoerDep := TRUE;
        IF NOT SensorUitgang THEN			//pallet is uit depalletizer vervolgens reset voor volgende pallet
            RolbandAanUit := FALSE;			//rolband uit
            AantalLagenVerwijderd := 0;
            TimerExtra(IN := FALSE);
            DepalletPalletBinnen := FALSE;
			KlaarVoorUitvoer := FALSE;
            Step := 0;     // terug naar stap 1 voor nieuwe palletinvoer in depalletizer
        END_IF
		ELSE
			TriggerState := E_PackMLStates.Suspending;
    END_IF



ELSE
    Step := 0;   // terug naar stap 1 als er iets fout gaat
END_CASE
]]></ST>
      </Implementation>
    </Method>
