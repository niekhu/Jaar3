    <Method Name="Resetting" Id="{86e32daa-1809-4afe-ae0a-050d304e9de2}" FolderPath="Methods\">
      <Declaration><![CDATA[METHOD Resetting : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CurrentStateDep := E_PackMLStates.Resetting;

Step := 0;
AantalLagenVerwijderd := 0;
TimerExtra(IN := FALSE);
DepalletPalletBinnen := FALSE;

TriggerState := E_PackMLStates.Idle;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Starting" Id="{0c8238a0-26f8-4256-bb0d-748493f97bd5}" FolderPath="Methods\">
      <Declaration><![CDATA[METHOD Starting : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//LET OP ik wist niet welke units terugmeldingen hebben dus evt moet je checks toevoegen
CurrentStateDep := E_PackMLStates.Starting;

IF  MotorSchuif.Status = E_MotorZuigSchuifStatus.Kort AND MotorZuig.Status = E_MotorZuigSchuifStatus.Kort AND		//check van startposities en sensoren op normale input
	Zuignap1.Status = E_VacuumzuignapStatus.SturingVacuumLoslaten AND						
	Zuignap2.Status = E_VacuumzuignapStatus.SturingVacuumLoslaten AND Zuignap3.Status = E_VacuumzuignapStatus.SturingVacuumLoslaten AND
	Zuignap4.Status = E_VacuumzuignapStatus.SturingVacuumLoslaten AND KlepDepalletEind.Status = TRUE	
	// (1) check of lift beneden is (servo) (2) check of pinnen ingetrokken zijn (3) check rolband stil
	THEN
	StartingPositiesOk := TRUE;
	
	ELSE
		StartingPositiesOk := FALSE;
		MotorSchuif.SturingKort();								//één of meer startcriteria die niet kloppen? sturen van startposities
		MotorZuig.SturingKort();
		Zuignap1.Loslaten();
		Zuignap2.Loslaten();
		Zuignap3.Loslaten();
		Zuignap4.Loslaten();
		KlepDepalletEind.SturingOpen(TRUE);
		//(1) stuur lift omlaag (servo) (2) stuur pinnen naar ingetrokken positie (3) stuur rolband stil
		
END_IF
	
	
IF DrukSensor1.Status = E_DruksensorStatus.SensorInputOk 	// (1) check of afstandssensor input ok is (2) check of lichtsensor input ok is
	THEN
	StartingSensorOk := TRUE;
	ELSE
		StartingSensorOk := FALSE;
END_IF



IF StartingPositiesOk = TRUE AND StartingSensorOk = TRUE THEN					//startcriteria goed? state verandert naar execute
	TriggerState := E_PackMLStates.Execute;
	StartingPositiesOk := FALSE;
	StartingSensorOk := FALSE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="Stopped" Id="{862a4bb4-364c-4936-8d10-c75d515773a0}" FolderPath="Methods\">
      <Declaration><![CDATA[METHOD Stopped : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CurrentStateDep := E_PackMLStates.Stopped;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Stopping" Id="{c84b4a38-09b8-40eb-889d-b8cb17a1f62f}" FolderPath="Methods\">
      <Declaration><![CDATA[METHOD Stopping : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//LET OP ik wist niet welke units terugmeldingen hebben dus evt moet je checks toevoegen
CurrentStateDep := E_PackMLStates.Stopping;

//mechanische rem erop

LiftBewegingYesNo := TRUE; //lift naar beneden
RolbandAanUit := FALSE;
MotorSchuif.SturingKort();
MotorZuig.SturingKort();
Zuignap1.Loslaten();
Zuignap2.Loslaten();
Zuignap3.Loslaten();
Zuignap4.Loslaten();



IF EindLiftBeneden = TRUE AND MotorSchuif.Status = E_MotorZuigSchuifStatus.Kort AND MotorZuig.Status = E_MotorZuigSchuifStatus.Kort
	AND Zuignap1.Status = E_VacuumzuignapStatus.SturingVacuumLoslaten AND Zuignap2.Status = E_VacuumzuignapStatus.SturingVacuumLoslaten 
 	AND Zuignap3.Status = E_VacuumzuignapStatus.SturingVacuumLoslaten AND Zuignap4.Status = E_VacuumzuignapStatus.SturingVacuumLoslaten THEN
	
	PinnenUitYesNo := FALSE;
	TriggerState := E_PackMLStates.Stopped;
END_IF

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Suspended" Id="{10bd4b16-4905-4f00-a760-dfd80c61558a}" FolderPath="Methods\">
      <Declaration><![CDATA[METHOD Suspended : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CurrentStateDep := E_PackMLStates.Suspended;

IF InputPalletVanafBufADep AND NOT DepalletPalletBinnen THEN	
	TriggerState := E_PackMLStates.Unsuspending;
END_IF

IF DepalletPalletBinnen AND NOT InputPalletBijUitgang THEN
	TriggerState := E_PackMLStates.Unsuspending;
END_IF

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Suspending" Id="{6449bf5c-880a-49ff-a3c3-47582521d253}" FolderPath="Methods\">
      <Declaration><![CDATA[METHOD Suspending : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CurrentStateDep := E_PackMLStates.Suspending;		// machine staat nu al stil anders kan hij hier niet komen vanuit execute

TriggerState := E_PackMLStates.Suspended;]]></ST>
      </Implementation>
    </Method>
