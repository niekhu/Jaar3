    <Method Name="Holding" Id="{9ee0f93f-9ee6-40ae-91af-7b218154d752}" FolderPath="Methods\">
      <Declaration><![CDATA[METHOD Holding : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CurrentStateDep := E_PackMLStates.Holding;

LiftbewegingYesNo := FALSE; 		//lift uit		//sturing om tot Held te komen
RolbandAanUit := FALSE;				//rolband uit

IF LiftbewegingYesNo = FALSE AND RolbandAanUit = FALSE AND (MotorSchuif.Status = E_MotorZuigSchuifStatus.Kort OR MotorSchuif.Status = E_MotorZuigSchuifStatus.Lang)
	AND (MotorZuig.Status = E_MotorZuigSchuifStatus.Kort OR MotorZuig.Status = E_MotorZuigSchuifStatus.Lang) THEN //evt nog check pinnen stil
	TriggerState := E_PackMLStates.Held;
END_IF


// de IF is checken of status Held is bereikt
//LET OP ik wist niet welke units terugmeldingen hebben dus evt moet je checks toevoegen]]></ST>
      </Implementation>
    </Method>
