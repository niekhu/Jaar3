      <Declaration><![CDATA[PROPERTY CurrentState : E_PackMLStates]]></Declaration>
      <Get Name="Get" Id="{abf65026-5da4-4773-9ad7-0771ec9a23a9}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[CurrentState := CurrentStateDep;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{6aece2b5-c6a5-460d-8bf7-a59f80b5ecaa}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
