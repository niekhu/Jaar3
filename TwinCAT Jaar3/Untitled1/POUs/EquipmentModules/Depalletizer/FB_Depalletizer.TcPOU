    <Property Name="AlarmenDepallet" Id="{42935b8e-377b-470c-ab11-71e67ce28088}" FolderPath="Properties\">
      <Declaration><![CDATA[PROPERTY AlarmenDepallet : ARRAY[1..20] OF ST_AlarmenDepalletizer]]></Declaration>
      <Get Name="Get" Id="{022fe51e-576e-4aa5-9b7f-a184868bb8a3}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
