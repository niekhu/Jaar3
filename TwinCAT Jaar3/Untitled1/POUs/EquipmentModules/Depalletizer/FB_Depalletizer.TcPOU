<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_Depalletizer" Id="{604c825a-b299-42a4-9d94-06f2cd7a73fd}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_Depalletizer IMPLEMENTS ITF_Depalletizer
VAR_INPUT
	MotorSchuif : ITF_MotorZuigSchuif;			//Alle benodigde Interfaces binnenhalen
	MotorZuig : ITF_MotorZuigSchuif;
	Zuignap1 : ITF_Vacuumzuignap;
	Zuignap2 : ITF_Vacuumzuignap;
	Zuignap3 : ITF_Vacuumzuignap;
	Zuignap4 : ITF_Vacuumzuignap;
	Druksensor1 : ITF_Druksensor;
	KlepDepalletEind : ITF_Klep;
	
END_VAR
VAR_OUTPUT
END_VAR
VAR
	//PackmlState input en current
	InputStateDep : E_PackMLStates;	
	CurrentStateDep : E_PackMLStates := E_PackMLStates.Idle;
	TriggerState : E_PackMLStates;
	VorigeInputState : E_PackMLStates;
	//eind var
	
	//Alarmen binnenhalen en opslaan
	Alarmrecord : ST_AlarmenDepalletizer;
	Alarmen : ARRAY[1..20] OF ST_AlarmenDepalletizer;
	AlarmDruksensor : E_DruksensorStatus;
	i : INT;
	AlarmDruksensor1Bestaat : BOOL;
	AlarmMotorSchuifBestaat : BOOL;
	AlarmMotorZuigBestaat : BOOL;				// Let op, hier toevoegen toevoegen als er een unit met alarm onder depalletizer valt
	fbLocalTime : FB_LocalSystemTime;
	//eind var
	
	//voor method starting
	StartingPositiesOk : BOOL;
	StartingSensorOk : BOOL;
	//eind var
	
	//voor method execute
	InputPalletVanafBufADep : BOOL; 
	InputPalletBijUitgangDep :BOOL; //koppelen via control
	KlaarVoorInvoerDep : BOOL;
	KlaarvoorUitvoerDep : BOOL;
	DepalletPalletBinnen : BOOL;
	TimerExtra : TON;
	MinimaleDrukZuignappen : LREAL := 1.875;
	AantalLagenBlikjesTotaal : INT := 3;
	AantalLagenVerwijderd : INT;
	Step : INT;
	//vanaf hier tijdelijke var door missende units. 	LET OP ik wist niet welke units terugmeldingen hebben dus evt moet je checks toevoegen
	RolbandAanUit : BOOL;
	LichtsensorDetectYesNo : BOOL;
	PinnenUitYesNo :BOOL;
	LiftBewegingYesNo : BOOL;
	AfstandssensorDetectYesNo : BOOL;
	ZuigBenedenBoven : BOOL;
	ZuigBenedenAangekomen : BOOL;
	ZuigBovenAangekomen : BOOL;
	SensorBlikjesOpBandYesNo : BOOL;
	EindLiftBeneden : BOOL;
	SensorUitgang : BOOL;
	//eind var tijdelijk en method execute

	//voor het uitvoeren van testplannen
	testbool : BOOL;
	testbool2 : BOOL;
	GelezenStatusMotorSchuif : E_MotorZuigSchuifStatus;
	GelezenStatusVacuumzuignap : E_VacuumzuignapStatus;
	GelezenDruk : REAL;
	GelezenStatusDruksensor : E_DruksensorStatus;
	Active: INT;
	joejoe : BOOL;
	// eind var
	
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[fbLocalTime();									//Huidige tijd bijhouden

IF InputStateDep <> VorigeInputState THEN		//Gebruikt voor method naar method activering terwijl geluisterd kan worden naar unit blok
	TriggerState := InputStateDep;
END_IF

VorigeInputState := InputStatedep;

CASE TriggerState OF							//switchcase die de method uitvoert die hoort bij de ontvangen Packmlstate

    E_PackMLStates.Idle:
        Idle();
		
	E_PackMLStates.Execute:
	Execute();	

    E_PackMLStates.Starting:
        Starting();

    E_PackMLStates.Resetting:
        Resetting();

    E_PackMLStates.Holding:
        Holding();

    E_PackMLStates.Unholding:
        Unholding();

    E_PackMLStates.Suspending:
        Suspending();

    E_PackMLStates.Unsuspending:
        Unsuspending();

    E_PackMLStates.Stopping:
        Stopping();
		
	E_PackMLStates.Suspended:
        Suspended(); 
		
	E_PackMLStates.Held:
        Held();	

	E_PackMLStates.Stopped:
        Stopped();	


END_CASE


// Vanaf hier controleren van errors van control modules en in property verwerken. Voor elke unit error hier een gelijke if toevoegen

IF Druksensor1.Status = E_DruksensorStatus.SensorInputError THEN
    // Alarm voor het eerst
	IF NOT AlarmDruksensor1Bestaat THEN
    FOR i := 1 TO 20 DO
        IF NOT Alarmen[i].Active THEN
            Alarmen[i].Source := 'Druksensor1Error';
            Alarmen[i].Text := 'InputBuitenRange';
            Alarmen[i].Timestamp := fbLocalTime.systemTime;
            Alarmen[i].Active := TRUE;
			AlarmDruksensor1Bestaat := TRUE;
            EXIT;
        END_IF
    END_FOR
	END_IF

ELSE
    // Alarm weg dus Active op FALSE zetten
    FOR i := 1 TO 20 DO
        IF Alarmen[i].Active AND
           Alarmen[i].Source = 'Druksensor1Error' AND
           Alarmen[i].Text = 'InputBuitenRange' THEN
            Alarmen[i].Active := FALSE;
			AlarmDruksensor1Bestaat := FALSE;
            EXIT; 
        END_IF
    END_FOR
END_IF


IF MotorZuig.Status = E_MotorZuigSchuifStatus.Error THEN
    // Alarm voor het eerst
	IF NOT AlarmMotorZuigBestaat THEN
    FOR i := 1 TO 20 DO
        IF NOT Alarmen[i].Active THEN
            Alarmen[i].Source := 'MotorZuigError';
            Alarmen[i].Text := 'InternetFout';
            Alarmen[i].Timestamp := fbLocalTime.systemTime;
            Alarmen[i].Active := TRUE;
			AlarmMotorZuigBestaat := TRUE;
            EXIT;
        END_IF
    END_FOR
	END_IF

ELSE
    // Alarm weg dus Active op FALSE zetten
    FOR i := 1 TO 20 DO
        IF Alarmen[i].Active AND
           Alarmen[i].Source = 'MotorZuigError' AND
           Alarmen[i].Text = 'InterneFout' THEN
            Alarmen[i].Active := FALSE;
			AlarmMotorZuigBestaat := FALSE;
            EXIT; 
        END_IF
    END_FOR
END_IF



IF MotorSchuif.Status = E_MotorZuigSchuifStatus.Error THEN
    // Alarm voor het eerst
	IF NOT AlarmMotorSchuifBestaat THEN
    FOR i := 1 TO 20 DO
        IF NOT Alarmen[i].Active THEN
            Alarmen[i].Source := 'MotorSchuifError';
            Alarmen[i].Text := 'InterneFout';
            Alarmen[i].Timestamp := fbLocalTime.systemTime;
            Alarmen[i].Active := TRUE;
			AlarmMotorSchuifBestaat := TRUE;
            EXIT;
        END_IF
    END_FOR
	END_IF

ELSE
    // Alarm weg dus Active op FALSE zetten
    FOR i := 1 TO 20 DO
        IF Alarmen[i].Active AND
           Alarmen[i].Source = 'MotorSchuifError' AND
           Alarmen[i].Text = 'InterneFout' THEN
            Alarmen[i].Active := FALSE;
			AlarmMotorSchuifBestaat := FALSE;
            EXIT; 
        END_IF
    END_FOR
END_IF







// hieronder om controls te testen

(* IF testbool = TRUE THEN
	MotorSchuif.SturingKort();
	Zuignap1.Loslaten();
END_IF

IF testbool2 = TRUE THEN
	MotorSchuif.SturingLang();
	Zuignap1.Oppakken();
END_IF

GelezenStatusMotorSchuif := MotorSchuif.Status;
GelezenStatusVacuumzuignap := Zuignap1.Status;
GelezenDruk := Druksensor1.Druk;
GelezenStatusDruksensor := Druksensor1.Status;

*)
]]></ST>
    </Implementation>
