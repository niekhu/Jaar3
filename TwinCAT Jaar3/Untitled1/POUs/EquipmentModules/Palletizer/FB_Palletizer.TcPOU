        <ST><![CDATA[CurrentStatePal := E_PackMLStates.Holding;

// Holding = gecontroleerd pauzeren (positie behouden)
// // RollerMotor.Stop();
// // LiftServo.HoldPosition();
// // StatusLamp.SetHold();

// Zodra alles stil staat -> Held
_ActiveStatePal := E_PackMLStates.Held;

Holding := TRUE;]]></ST>
      </Implementation>
    </Method>
