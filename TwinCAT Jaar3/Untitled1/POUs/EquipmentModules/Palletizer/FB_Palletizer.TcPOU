    <Method Name="Resetting" Id="{db63cd78-6dfc-4b29-9463-c18ba5eaec19}" FolderPath="Methods\">
      <Declaration><![CDATA[METHOD PUBLIC Resetting : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CurrentStatePal := E_PackMLStates.Resetting;

// Resetting = alles naar basis/idle condities
// // _AlarmActive := FALSE;
// // _AlarmCode := 0;
// // Step := 0;
// // RollerMotor.Stop();
// // LiftServo.GoHome();
// // Pin1.Retract(); Pin2.Retract(); Pin3.Retract(); Pin4.Retract();
// // StatusLamp.SetResetting();

// Reset klaar -> Idle
_ActiveStatePal := E_PackMLStates.Idle;
Step := 0;

Resetting := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Starting" Id="{4a3e5953-84c4-41e7-a958-1b74ee60f666}" FolderPath="Methods\">
      <Declaration><![CDATA[METHOD PUBLIC Starting : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CurrentStatePal := E_PackMLStates.Starting;

// Doel starting: naar veilige startpositie / klaar om pallets te verwerken
// Voorbeelden (later):
// // RollerMotor.Stop();
// // LiftServo.GoHome();                 // lift naar startpositie
// // Pin1.Retract(); Pin2.Retract(); Pin3.Retract(); Pin4.Retract();
// // StatusLamp.SetStarting();
// // IF EStopOk = FALSE THEN
// //     // _AlarmActive := TRUE; _AlarmCode := 1001;
// // END_IF

// Startcondities checken (later met echte statuses)
// IF (LiftServo.Status = Home) AND (Pin1.Status = Retracted) AND ... THEN
//     _ActiveStatePal := E_PackMLStates.Execute;
//     Step := 0;
// END_IF

// Voor nu: direct door naar Execute (zodat je ziet dat flow werkt)
_ActiveStatePal := E_PackMLStates.Execute;
Step := 0;

Starting := TRUE;]]></ST>
      </Implementation>
    </Method>
