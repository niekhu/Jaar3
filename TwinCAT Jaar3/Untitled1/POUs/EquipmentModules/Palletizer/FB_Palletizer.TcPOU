    <Property Name="EStopOk" Id="{f31c760d-6c16-463a-9eca-26809f55fd3c}" FolderPath="Properties\">
      <Declaration><![CDATA[PROPERTY EStopOk : BOOL]]></Declaration>
      <Get Name="Get" Id="{004a68f6-c794-41bf-8766-161c9ab2aa7d}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[EStopOk := _EStopOk;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{8d171750-53fb-49e1-9f26-19141af429de}">
        <Declaration><![CDATA[VAR
END_VAR
