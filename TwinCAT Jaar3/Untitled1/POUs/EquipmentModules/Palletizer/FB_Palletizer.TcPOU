    <Method Name="Resetting" Id="{db63cd78-6dfc-4b29-9463-c18ba5eaec19}" FolderPath="Methods\">
      <Declaration><![CDATA[METHOD PUBLIC Resetting : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CurrentStatePal := E_PackMLStates.Resetting;

Step := 0;
_AlarmActive := FALSE;
_AlarmCode := 0;

TriggerState := E_PackMLStates.Idle;

Resetting := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Starting" Id="{4a3e5953-84c4-41e7-a958-1b74ee60f666}" FolderPath="Methods\">
      <Declaration><![CDATA[METHOD PUBLIC Starting : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CurrentStatePal := E_PackMLStates.Starting;

RolbandAanUit := FALSE;

LiftOmlaagYesNo := TRUE;
LiftOmhoogYesNo := FALSE;

Pin1UitYesNo := FALSE;
Pin2UitYesNo := FALSE;
Pin3UitYesNo := FALSE;
Pin4UitYesNo := FALSE;

IF  _EStopOk AND NOT _DoorIsOpen AND
	LiftBenedenAangekomen_FB AND
	Pin1InAangekomen AND Pin2InAangekomen AND Pin3InAangekomen AND Pin4InAangekomen
THEN
	TriggerState := E_PackMLStates.Execute;
	Step := 0;
END_IF

Starting := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Stopped" Id="{33b48153-f3a7-47de-8cf8-6ac124fe3b32}" FolderPath="Methods\">
      <Declaration><![CDATA[METHOD PUBLIC Stopped : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CurrentStatePal := E_PackMLStates.Stopped;

RolbandAanUit := FALSE;
LiftOmhoogYesNo := FALSE;
