    <Method Name="Execute" Id="{16a58c6d-d9e6-4e7f-a0b7-9d7181b8bae5}" FolderPath="Methods\">
      <Declaration><![CDATA[METHOD PUBLIC Execute : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CurrentStatePal := E_PackMLStates.Execute;

// Safety: deur open tijdens Execute -> naar Stopping
IF _DoorIsOpen OR NOT _EStopOk THEN
    RolbandAanUit := FALSE;
    LiftOmhoogYesNo := FALSE;
    LiftOmlaagYesNo := FALSE;

    Pin1UitYesNo := FALSE;
    Pin2UitYesNo := FALSE;
    Pin3UitYesNo := FALSE;
    Pin4UitYesNo := FALSE;

    TriggerState := E_PackMLStates.Stopping;
    Execute := TRUE;
    RETURN;
END_IF

CASE Step OF

0:
	IF _PalletAtInFeed AND NOT _StorageFull THEN
		RolbandAanUit := TRUE;

		IF _PalletInPosition THEN
			RolbandAanUit := FALSE;
			Step := 10;
		END_IF
	ELSE
		RolbandAanUit := FALSE;
	END_IF


10:
	Pin1UitYesNo := TRUE;
	Pin2UitYesNo := TRUE;
	Pin3UitYesNo := TRUE;
	Pin4UitYesNo := TRUE;

	IF Pin1UitAangekomen AND Pin2UitAangekomen AND Pin3UitAangekomen AND Pin4UitAangekomen THEN
		Step := 20;
	END_IF


20:
	LiftOmhoogYesNo := TRUE;
	LiftOmlaagYesNo := FALSE;

	IF LiftBovenAangekomen_FB THEN
		LiftOmhoogYesNo := FALSE;
		Step := 30;
	END_IF


30:
	Pin1UitYesNo := FALSE;
	Pin2UitYesNo := FALSE;
	Pin3UitYesNo := FALSE;
	Pin4UitYesNo := FALSE;

	IF Pin1InAangekomen AND Pin2InAangekomen AND Pin3InAangekomen AND Pin4InAangekomen THEN
		Step := 40;
	END_IF


40:
	LiftOmlaagYesNo := TRUE;
	LiftOmhoogYesNo := FALSE;

	IF LiftBenedenAangekomen_FB THEN
		LiftOmlaagYesNo := FALSE;

		_PalletAtInFeed := FALSE;
		_PalletInPosition := FALSE;

		Step := 0;
	END_IF


ELSE
	Step := 0;
END_CASE

Execute := TRUE;
]]></ST>
      </Implementation>
    </Method>
