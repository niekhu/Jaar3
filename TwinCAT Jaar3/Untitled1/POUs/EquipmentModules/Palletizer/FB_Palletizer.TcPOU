    <Method Name="Suspended" Id="{6a115e32-659e-43cc-88d2-1267419091bd}" FolderPath="Methods\">
      <Declaration><![CDATA[METHOD PUBLIC Suspended : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CurrentStatePal := E_PackMLStates.Suspended;

// In suspended wacht je op Unsuspending command
// // alles blijft veilig uit

Suspended := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Suspending" Id="{0dd5f12e-8033-42e3-9131-1e90a5f8e595}" FolderPath="Methods\">
      <Declaration><![CDATA[METHOD PUBLIC Suspending : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CurrentStatePal := E_PackMLStates.Suspending;

// Suspending = gecontroleerd naar veilige toestand om later opnieuw te starten
// (bijv. na error / geen input / wachttijd)
// // RollerMotor.Stop();
// // LiftServo.GoSafe();
// // Pin1.Retract(); Pin2.Retract(); Pin3.Retract(); Pin4.Retract();
// // StatusLamp.SetSuspending();

// Als veilig -> Suspended
_ActiveStatePal := E_PackMLStates.Suspended;

Suspending := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Unholding" Id="{2351bdac-eb65-45f6-a51b-6a7044f90e63}" FolderPath="Methods\">
      <Declaration><![CDATA[METHOD PUBLIC Unholding : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CurrentStatePal := E_PackMLStates.Unholding;

// Unholding = hervatten vanuit waar je was
// // StatusLamp.SetResume();

// Direct terug naar Execute (jij wilt Unholding -> Execute)
_ActiveStatePal := E_PackMLStates.Execute;

Unholding := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Unsuspending" Id="{1ee279d3-4eb2-48a5-ba89-aef09f4f2dbe}" FolderPath="Methods\">
      <Declaration><![CDATA[METHOD PUBLIC Unsuspending : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CurrentStatePal := E_PackMLStates.Unsuspending;

// Unsuspending = weer klaarzetten en dan doorgaan
// // StatusLamp.SetUnsuspending();
// // check safe ok -> dan execute

_ActiveStatePal := E_PackMLStates.Execute;

Unsuspending := TRUE;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>