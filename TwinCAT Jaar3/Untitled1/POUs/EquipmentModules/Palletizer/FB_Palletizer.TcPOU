<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_Palletizer" Id="{01892087-3837-44fd-a643-766816d2ad24}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_Palletizer IMPLEMENTS ITF_Palletizer
VAR_INPUT
    // Alles komt later als echte units/interfaces. Nu alleen placeholders in comments.
    // RollerMotor       : ITF_Motor;            // elektro asynchroon motor (rollerband)
    // LiftServo         : ITF_Servo;            // servo ketting lift
    // Pin1              : ITF_LinearActuator;   // 4x pinnen
    // Pin2              : ITF_LinearActuator;
    // Pin3              : ITF_LinearActuator;
    // Pin4              : ITF_LinearActuator;
    // LsInfeed          : ITF_Lichtsensor;      // lichtsensor ingang
    // LsPosition        : ITF_Lichtsensor;      // lichtsensor einde/positie
    // DistanceFull      : ITF_Afstandssensor;   // opslag vol
    // DoorSensor        : ITF_DeurSensor;       // deur open sensor
    // LimitSwitch       : ITF_LimitSwitch;      // limit switch (positie onbekend)
    // EStop             : ITF_Noodstop;         // noodstop
    // OpenButton        : ITF_DrukKnop;         // open knop met licht
    // ResetButton       : ITF_DrukKnop;         // reset knop met licht
    // StatusLamp        : ITF_StatusLamp;       // machinestatuslamp
END_VAR

VAR
    // =========================
    // PackML command & status
    // =========================
    _CmdStatePal    : E_PackMLStates := E_PackMLStates.Idle;   // van control (1x trigger)
    _ActiveStatePal : E_PackMLStates := E_PackMLStates.Idle;   // interne actieve state
    CurrentStatePal : E_PackMLStates := E_PackMLStates.Idle;   // feedback naar control

    TriggerState : E_PackMLStates := E_PackMLStates.Idle;      // toegevoegd (zoals Depalletizer)
    VorigeInputState : E_PackMLStates := E_PackMLStates.Idle;  // toegevoegd

    // =========================
    // Alarm / safety (later)
    // =========================
    _AlarmActive : BOOL := FALSE;
    _AlarmCode   : UDINT := 0;
    _EStopOk     : BOOL := TRUE;    // later: EStop.Ok
    _DoorIsOpen   : BOOL := FALSE;   // later: DoorSensor.Open

    // =========================
    // Deur bediening (later)
    // =========================
    _DoorOpenRequest  : BOOL := FALSE;  // request vanuit control/HMI
    _DoorOpenAllowed  : BOOL := FALSE;  // berekend (later)

    // =========================
    // Proces signalen (later)
    // =========================
    _PalletAtInFeed    : BOOL := FALSE; // later: LsInfeed.Detect
    _PalletInPosition  : BOOL := FALSE; // later: LsPosition.Detect
    _StorageFull       : BOOL := FALSE; // later: DistanceFull.Full

    // Execute sequence (later)
    Step : INT := 0;

	//vanaf hier tijdelijke var door missende units
	RolbandAanUit : BOOL;
	LiftOmhoogYesNo : BOOL;
	LiftOmlaagYesNo : BOOL;

	Pin1UitYesNo : BOOL;
	Pin2UitYesNo : BOOL;
	Pin3UitYesNo : BOOL;
	Pin4UitYesNo : BOOL;

	// “feedback” die jij handmatig zet om steps door te laten lopen
	Pin1UitAangekomen : BOOL;
	Pin2UitAangekomen : BOOL;
	Pin3UitAangekomen : BOOL;
	Pin4UitAangekomen : BOOL;

	Pin1InAangekomen : BOOL;
	Pin2InAangekomen : BOOL;
	Pin3InAangekomen : BOOL;
	Pin4InAangekomen : BOOL;
	
	LiftBovenAangekomen : BOOL;
	LiftBenedenAangekomen : BOOL;

	//eind var
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// 1) Latch command -> active (zodat 1x trigger genoeg is)
IF _CmdStatePal <> VorigeInputState THEN
    TriggerState := _CmdStatePal;
END_IF

VorigeInputState := _CmdStatePal;

// 2) Feedback state (wat ik NU aan het doen ben)
CurrentStatePal := TriggerState;

// 3) (optioneel) bereken deur-toestemming (nu nog simpel; later met echte voorwaarden)
_DoorOpenAllowed := _EStopOk AND (CurrentStatePal = E_PackMLStates.Idle OR CurrentStatePal = E_PackMLStates.Stopped OR CurrentStatePal = E_PackMLStates.Held OR CurrentStatePal = E_PackMLStates.Suspended);
// later (voorbeeld):
// _DoorOpenAllowed := _EStopOk AND (CurrentStatePal = E_PackMLStates.Idle OR CurrentStatePal = E_PackMLStates.Stopped OR CurrentStatePal = E_PackMLStates.Held OR CurrentStatePal = E_PackMLStates.Suspended);

// 4) PackML state machine (methods maak jij hierna aan)
CASE TriggerState OF

    E_PackMLStates.Idle:
        Idle();

    E_PackMLStates.Starting:
        Starting();

    E_PackMLStates.Execute:
        Execute();

    E_PackMLStates.Holding:
        Holding();

    E_PackMLStates.Held:
        Held();

    E_PackMLStates.Unholding:
        Unholding();

    E_PackMLStates.Suspending:
        Suspending();

    E_PackMLStates.Suspended:
        Suspended();

    E_PackMLStates.Unsuspending:
        Unsuspending();

    E_PackMLStates.Stopping:
        Stopping();

    E_PackMLStates.Stopped:
        Stopped();

    E_PackMLStates.Resetting:
        Resetting();

END_CASE
]]></ST>
    </Implementation>
