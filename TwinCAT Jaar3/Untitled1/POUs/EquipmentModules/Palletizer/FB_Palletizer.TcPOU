    <Method Name="Execute" Id="{16a58c6d-d9e6-4e7f-a0b7-9d7181b8bae5}" FolderPath="Methods\">
      <Declaration><![CDATA[METHOD PUBLIC Execute : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CurrentStatePal := E_PackMLStates.Execute;

// Doel execute: pallet innemen, pinnen grijpen, lift stapelen, terug naar rust
// Alles in steps zodat je later makkelijk units invult.

CASE Step OF

    0: // Wachten op pallet bij ingang
        // IF StorageFull THEN
        //     // RollerMotor.Stop();
        //     // StatusLamp.SetFull();
        //     // evt Holding() of Stopping() afhankelijk van ontwerp
        // ELSE
        //     // RollerMotor.Run();
        // END_IF

        // IF PalletAtInFeed THEN
        //     // RollerMotor.Run(); // pallet door laten lopen
        //     Step := 10;
        // END_IF

        // Placeholder
        // Step := 0;

    10: // Pallet naar positie rijden tot lichtsensor einde/positie
        // IF PalletInPosition THEN
        //     // RollerMotor.Stop();
        //     Step := 20;
        // END_IF

    20: // Pinnen uitschuiven om pallet te grijpen
        // Pin1.Extend(); Pin2.Extend(); Pin3.Extend(); Pin4.Extend();
        // IF Pin1.Status = Extended AND Pin2.Status = Extended AND Pin3.Status = Extended AND Pin4.Status = Extended THEN
        //     Step := 30;
        // END_IF

    30: // Lift omhoog (stack maken)
        // LiftServo.MoveUpOneLevel();  // of MoveToHeight(...)
        // IF LimitSwitch / PositionReached THEN
        //     Step := 40;
        // END_IF

    40: // Nieuwe pallet kan eronder: bestaande stapel omhoog -> afhankelijk mechaniek
        // // hier zou je ook de stack-logica doen (hoeveel pallets, hoogte etc.)
        // Step := 50;

    50: // Lift terug naar rust / pallets neerzetten
        // LiftServo.GoHome();
        // IF LiftServo.Status = Home THEN
        //     Step := 60;
        // END_IF

    60: // Pinnen intrekken en klaar voor volgende pallet
        // Pin1.Retract(); Pin2.Retract(); Pin3.Retract(); Pin4.Retract();
        // IF Pin1.Status = Retracted AND ... THEN
        //     Step := 0;
        // END_IF

ELSE
    Step := 0;
END_CASE;

Execute := TRUE;]]></ST>
      </Implementation>
    </Method>
