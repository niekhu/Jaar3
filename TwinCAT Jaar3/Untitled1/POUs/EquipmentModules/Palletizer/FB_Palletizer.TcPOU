    <Method Name="Idle" Id="{14dcf620-4eca-4676-82d0-855220591e82}" FolderPath="Methods\">
      <Declaration><![CDATA[METHOD PUBLIC Idle : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CurrentStatePal := E_PackMLStates.Idle;

RolbandAanUit := FALSE;

LiftOmhoogYesNo := FALSE;
LiftOmlaagYesNo := TRUE;

Pin1UitYesNo := FALSE;
Pin2UitYesNo := FALSE;
Pin3UitYesNo := FALSE;
Pin4UitYesNo := FALSE;

Step := 0;

Idle := TRUE;
]]></ST>
      </Implementation>
    </Method>
