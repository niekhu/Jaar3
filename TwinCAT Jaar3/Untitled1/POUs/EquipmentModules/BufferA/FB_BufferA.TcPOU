<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_BufferA" Id="{f4348fe5-00a7-44c8-b996-13a856095685}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_BufferA IMPLEMENTS ITF_BufferA

VAR_INPUT
    Klep : ITF_Klep;          // unit-klep van Buffer A
END_VAR
VAR
    // =========================================================
    // PackML (zelfde patroon als Depalletizer)
    // =========================================================
    TriggerState     : E_PackMLStates := E_PackMLStates.Idle;
    VorigeInputState : E_PackMLStates := E_PackMLStates.Idle;

    // =========================================================
    // Backing vars voor properties (koppel je properties hieraan)
    // =========================================================
    _inInputState              : E_PackMLStates := E_PackMLStates.Idle; // <- property InputState (SET)
    _inDepalletizerReady       : BOOL;                                  // <- property DepalletizerReady (SET)
    _inPalletDetected          : BOOL;                                  // <- property PalletDetected (SET of unit)
    _outCurrentState           : E_PackMLStates := E_PackMLStates.Idle; // <- property CurrentState (GET)
    _outOutputPalletNaarDepal  : BOOL;                                  // <- property OutputPalletNaarDepallet (GET)

    // =========================================================
    // Werk-variabelen (met test overrides)
    // =========================================================
    PalletDetectedW   : BOOL;
    DepalletizerReadyW: BOOL;

    // =========================================================
    // Tijdelijke vars door missende units (net als bij Wesse)
    // =========================================================
    RolbandAanUit : BOOL;       // later echte unit / interface

    // =========================================================
    // Testbools (simpel testen zonder units)
    // testbool1: force pallet aanwezig
    // testbool2: force pallet NIET aanwezig
    // testbool3: force depalletizer ready
    // testbool4: force depalletizer NIET ready
    // =========================================================
    testbool1 : BOOL;
    testbool2 : BOOL;
    testbool3 : BOOL;
    testbool4 : BOOL;

    // "Gelezen" debug (voor online volgen)
    GelezenKlepStatus           : BOOL;
    GelezenCurrentStateBufA     : E_PackMLStates;
    GelezenOutputPalletNaarDepal: BOOL;
    GelezenPalletDetected       : BOOL;
    GelezenDepalletizerReady    : BOOL;
	
	// alarm
	_AlarmActive : BOOL;
	_AlarmCode : UDINT;

	// unit status lezen
	_GelezenKlepUnitStatus : E_UnitStatus;
END_VAR


(* oude code 
VAR_INPUT
    Klep : ITF_UnitKlep;          // unit-klep van Buffer A
END_VAR
VAR
    // PackML command (1x getriggerd door control)
    _CmdStateBufA : E_PackMLStates := E_PackMLStates.Idle;

    // Interne actieve state (hier draait de buffer écht op)
    _ActiveStateBufA : E_PackMLStates := E_PackMLStates.Idle;

    // Feedback naar control (wat doe ik NU)
    CurrentStateBufA : E_PackMLStates := E_PackMLStates.Idle;

    // later te gebruiken signalen (nu alleen comments)
    _PalletDetected     : BOOL;  // // lichtsensor Buffer A
    _DepalletizerReady  : BOOL;  // // depalletizer kan pallet ontvangen
    _OutputPalletNaarDepallet : BOOL;
END_VAR
*)
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =========================================================
// 1) Werkwaarden bepalen + test overrides
// =========================================================
PalletDetectedW := _inPalletDetected;
DepalletizerReadyW := _inDepalletizerReady;

IF testbool1 THEN PalletDetectedW := TRUE; END_IF;
IF testbool2 THEN PalletDetectedW := FALSE; END_IF;
IF testbool3 THEN DepalletizerReadyW := TRUE; END_IF;
IF testbool4 THEN DepalletizerReadyW := FALSE; END_IF;

// =========================================================
// 2) TriggerState alleen updaten bij wijziging InputState
// =========================================================
IF _inInputState <> VorigeInputState THEN
    TriggerState := _inInputState;
END_IF
VorigeInputState := _inInputState;

// =========================================================
// 3) Methods uitvoeren obv TriggerState
// =========================================================
CASE TriggerState OF

    E_PackMLStates.Idle:
        Idle();

    E_PackMLStates.Starting:
        Starting();

    E_PackMLStates.Execute:
        Execute();

    E_PackMLStates.Resetting:
        Resetting();

    E_PackMLStates.Holding:
        Holding();

    E_PackMLStates.Held:
        Held();

    E_PackMLStates.Unholding:
        Unholding();

    E_PackMLStates.Suspending:
        Suspending();

    E_PackMLStates.Suspended:
        Suspended();

    E_PackMLStates.Unsuspending:
        Unsuspending();

    E_PackMLStates.Stopping:
        Stopping();

    E_PackMLStates.Stopped:
        Stopped();
ELSE
	TriggerState := E_PackMLStates.Idle;
END_CASE




// =========================================================
// 4) Debug “gelezen” variabelen
// =========================================================
GelezenKlepStatus            := Klep.Status;
GelezenCurrentStateBufA      := _outCurrentState;
GelezenOutputPalletNaarDepal := _outOutputPalletNaarDepal;
GelezenPalletDetected        := PalletDetectedW;
GelezenDepalletizerReady     := DepalletizerReadyW;]]></ST>
    </Implementation>
