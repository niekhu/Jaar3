    <Method Name="Resetting" Id="{94902bf6-9535-4301-a4f2-60668b114e79}" FolderPath="Methods\">
      <Declaration><![CDATA[METHOD PUBLIC Resetting : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CurrentStateBufA := E_PackMLStates.Resetting;

// Reset: alles naar basis → klep dicht
Klep.SturingOpen(FALSE);

IF Klep.Status = FALSE THEN
    _ActiveStateBufA := E_PackMLStates.Idle;
    // later:
    // // Step := 0;
    // // timers reset
END_IF;

Resetting := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Starting" Id="{52e7ac40-d502-4f4e-8f61-f6f2ce8f7994}" FolderPath="Methods\">
      <Declaration><![CDATA[METHOD PUBLIC Starting : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CurrentStateBufA := E_PackMLStates.Starting;

// Startconditie: klep naar veilig (dicht)
Klep.SturingOpen(FALSE); // FALSE = dicht

// Klaar met Starting? → door naar Execute
// Pas deze check aan aan jouw echte statusbetekenis:
IF Klep.Status = FALSE THEN
    _ActiveStateBufA := E_PackMLStates.Execute;
END_IF;

// later:
// // AND Motor.Status = Off
// // AND Lichtsensor.Status = NoDetect

Starting := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Stopped" Id="{c0991e28-a91a-42ca-9e5c-1716ef3e21bc}" FolderPath="Methods\">
      <Declaration><![CDATA[METHOD PUBLIC Stopped : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CurrentStateBufA := E_PackMLStates.Stopped;

// Zeker weten dat de klep dicht staat
IF Klep.Status THEN
    Klep.SturingOpen(FALSE);          // FALSE = dicht
END_IF;

Stopped := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Stopping" Id="{beb6be39-b0ad-4a16-8041-cb85d93f20a5}" FolderPath="Methods\">
      <Declaration><![CDATA[METHOD PUBLIC Stopping : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CurrentStateBufA := E_PackMLStates.Stopping;

// Stopping: netjes stoppen → klep dicht
Klep.SturingOpen(FALSE);

IF Klep.Status = FALSE THEN
    _ActiveStateBufA := E_PackMLStates.Stopped;
END_IF;

// later:
// // Motor.Stop();

Stopping := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Suspended" Id="{8f6f27b6-0738-496f-ad57-64e4cb65ba51}" FolderPath="Methods\">
      <Declaration><![CDATA[METHOD PUBLIC Suspended : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CurrentStateBufA := E_PackMLStates.Suspended;

// Suspended = veilig stilstaand
// Voor nu: klep dicht
IF Klep.Status THEN
    Klep.SturingOpen(FALSE);     // FALSE = dicht
END_IF;

// later:
// // Motor.Stop();
// // wacht op Unsuspending-command (herstart)

Suspended := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Suspending" Id="{035c5fa3-9f75-4cb8-85a2-1d53998c10e3}" FolderPath="Methods\">
      <Declaration><![CDATA[METHOD PUBLIC Suspending : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CurrentStateBufA := E_PackMLStates.Suspending;

// Suspending: veilig stilzetten → klep dicht
Klep.SturingOpen(FALSE);

// Klaar? → Suspended
IF Klep.Status = FALSE THEN
    _ActiveStateBufA := E_PackMLStates.Suspended;
END_IF;

// later:
// // Motor.Stop();
// // eventueel markeren dat je straks opnieuw wilt starten

Suspending := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Unholding" Id="{1c760e06-dd2a-4b03-afbc-48595da354d3}" FolderPath="Methods\">
      <Declaration><![CDATA[METHOD PUBLIC Unholding : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CurrentStateBufA := E_PackMLStates.Unholding;

// Unholding: pauze opheffen → direct terug naar Execute
// (geen reset naar rustpositie)
_ActiveStateBufA := E_PackMLStates.Execute;

// later:
// // niets resetten (Step blijft staan)

Unholding := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Unsuspending" Id="{29d85dfd-2bd2-463c-b952-24c8427bffcb}" FolderPath="Methods\">
      <Declaration><![CDATA[METHOD PUBLIC Unsuspending : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CurrentStateBufA := E_PackMLStates.Unsuspending;

// Unsuspending: hervatten NA onderbreking
// 1) eerst rustpositie (klep dicht)
// 2) daarna terug naar Execute (waar je dan opnieuw kan beginnen)
Klep.SturingOpen(FALSE);

IF Klep.Status = FALSE THEN
    _ActiveStateBufA := E_PackMLStates.Execute;
    // later:
    // // Step := 0;  // opnieuw beginnen
END_IF;

Unsuspending := TRUE;
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>