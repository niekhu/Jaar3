<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_BufferA" Id="{f4348fe5-00a7-44c8-b996-13a856095685}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_BufferA IMPLEMENTS ITF_BufferA
VAR_INPUT
    Klep : ITF_UnitKlep;          // unit-klep van Buffer A
END_VAR
VAR
    // PackML command (1x getriggerd door control)
    _CmdStateBufA : E_PackMLStates := E_PackMLStates.Idle;

    // Interne actieve state (hier draait de buffer écht op)
    _ActiveStateBufA : E_PackMLStates := E_PackMLStates.Idle;

    // Feedback naar control (wat doe ik NU)
    CurrentStateBufA : E_PackMLStates := E_PackMLStates.Idle;

    // later te gebruiken signalen (nu alleen comments)
    _PalletDetected     : BOOL;  // // lichtsensor Buffer A
    _DepalletizerReady  : BOOL;  // // depalletizer kan pallet ontvangen
    _OutputPalletNaarDepallet : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[CASE _ActiveStateBufA OF

    E_PackMLStates.Idle:
        Idle();

    E_PackMLStates.Starting:
        Starting();

    E_PackMLStates.Execute:
        Execute();

    E_PackMLStates.Resetting:
        Resetting();

    E_PackMLStates.Holding:
        Holding();

    E_PackMLStates.Held:
        Held();

    E_PackMLStates.Unholding:
        Unholding();

    E_PackMLStates.Suspending:
        Suspending();

    E_PackMLStates.Suspended:
        Suspended();

    E_PackMLStates.Unsuspending:
        Unsuspending();

    E_PackMLStates.Stopping:
        Stopping();

    E_PackMLStates.Stopped:
        Stopped();

END_CASE]]></ST>
    </Implementation>
    <Folder Name="Methods" Id="{0ebe38f1-04b8-4439-9d6e-d2c4e985b1f4}" />
    <Folder Name="Properties" Id="{a8e3dc76-af7a-439b-a9e5-02b228da3813}" />
    <Property Name="CurrentState" Id="{22976e27-03bd-461c-a25e-c44c78050df1}" FolderPath="Properties\">
      <Declaration><![CDATA[PROPERTY PUBLIC CurrentState : E_PackMLStates]]></Declaration>
      <Get Name="Get" Id="{1f57e63b-f978-4713-91b4-e10e152828f8}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[CurrentState := CurrentStateBufA;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{cde23ec8-4002-4e6f-9b23-fb3ffcb334da}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[CurrentStateBufA := CurrentState;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="DepalletizerReady" Id="{e8df924c-5ac5-4da0-8458-fb1d694f5523}" FolderPath="Properties\">
