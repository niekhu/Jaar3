    <Property Name="DepalletizerReady" Id="{e8df924c-5ac5-4da0-8458-fb1d694f5523}" FolderPath="Properties\">
      <Declaration><![CDATA[PROPERTY PUBLIC DepalletizerReady : BOOL]]></Declaration>
      <Get Name="Get" Id="{8fcb829b-bca0-4100-89a2-e1ed43247008}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[DepalletizerReady := _inDepalletizerReady;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{17acb11b-00f5-4ed7-be55-74d4844fd6eb}">
        <Declaration><![CDATA[VAR
