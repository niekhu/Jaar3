    <Method Name="Resetting" Id="{94902bf6-9535-4301-a4f2-60668b114e79}" FolderPath="Methods\">
      <Declaration><![CDATA[METHOD PUBLIC Resetting : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_outCurrentState := E_PackMLStates.Resetting;
_outOutputPalletNaarDepal := FALSE;

RolbandAanUit := FALSE;
Klep.SturingOpen(TRUE);

_AlarmActive := FALSE;
_AlarmCode := 0;


// Klaar? -> Idle
IF Klep.Status = TRUE THEN
    TriggerState := E_PackMLStates.Idle;
END_IF

Resetting := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Starting" Id="{52e7ac40-d502-4f4e-8f61-f6f2ce8f7994}" FolderPath="Methods\">
      <Declaration><![CDATA[METHOD PUBLIC Starting : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_outCurrentState := E_PackMLStates.Starting;
_outOutputPalletNaarDepal := FALSE;

// Start: naar “doorlaat-positie” of “basis-positie” (jij had FALSE hier)
Klep.SturingOpen(FALSE);

// Zodra klep op positie is -> naar Execute
IF Klep.Status = FALSE THEN
    TriggerState := E_PackMLStates.Execute;
END_IF

Starting := TRUE;
]]></ST>
      </Implementation>
    </Method>
