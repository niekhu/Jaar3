    <Method Name="Execute" Id="{3bae9621-bf61-4f4e-8037-2783d181ed4d}" FolderPath="Methods\">
      <Declaration><![CDATA[METHOD PUBLIC Execute : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_outCurrentState := E_PackMLStates.Execute;

// Simpelste test-logica zolang units ontbreken:
// - pallet gedetecteerd + depallet ready => doorlaten + output TRUE
// - pallet gedetecteerd + NIET ready   => tegenhouden + output FALSE
// - geen pallet                        => klaarzetten voor nieuwe pallet

IF PalletDetectedW AND DepalletizerReadyW THEN
    Klep.SturingOpen(FALSE);               // doorlaten
    RolbandAanUit := TRUE;
    _outOutputPalletNaarDepal := TRUE;

ELSIF PalletDetectedW AND NOT DepalletizerReadyW THEN
    Klep.SturingOpen(TRUE);                // tegenhouden
    RolbandAanUit := FALSE;
    _outOutputPalletNaarDepal := FALSE;

ELSE
    Klep.SturingOpen(FALSE);               // klaar voor nieuwe pallet
    RolbandAanUit := TRUE;
    _outOutputPalletNaarDepal := FALSE;
END_IF

Execute := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Held" Id="{7de6d903-1642-4780-83ef-024fa07c02d4}" FolderPath="Methods\">
      <Declaration><![CDATA[METHOD PUBLIC Held : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_outCurrentState := E_PackMLStates.Held;
_outOutputPalletNaarDepal := FALSE;

RolbandAanUit := FALSE;
Klep.SturingOpen(TRUE);

Held := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Holding" Id="{f3215803-7556-4f9c-ac5c-659c067ba981}" FolderPath="Methods\">
      <Declaration><![CDATA[METHOD PUBLIC Holding : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_outCurrentState := E_PackMLStates.Holding;
_outOutputPalletNaarDepal := FALSE;

RolbandAanUit := FALSE;
Klep.SturingOpen(TRUE);

IF Klep.Status = TRUE THEN
    TriggerState := E_PackMLStates.Held;
END_IF

Holding := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Idle" Id="{d321b098-3b8d-4f60-b30b-e293959ea482}" FolderPath="Methods\">
      <Declaration><![CDATA[METHOD PUBLIC Idle : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_outCurrentState := E_PackMLStates.Idle;
_outOutputPalletNaarDepal := FALSE;
RolbandAanUit := FALSE;

// Veilig: pallet blokkeren (AANNAMES: TRUE = “omhoog/blokkeren”)
Klep.SturingOpen(TRUE);

Idle := TRUE;
]]></ST>
      </Implementation>
    </Method>
