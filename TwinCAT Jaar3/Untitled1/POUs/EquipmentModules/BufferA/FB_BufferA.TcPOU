      <Get Name="Get" Id="{8fcb829b-bca0-4100-89a2-e1ed43247008}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[DepalletizerReady := _DepalletizerReady;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{17acb11b-00f5-4ed7-be55-74d4844fd6eb}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[_DepalletizerReady := DepalletizerReady;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="Execute" Id="{3bae9621-bf61-4f4e-8037-2783d181ed4d}" FolderPath="Methods\">
      <Declaration><![CDATA[METHOD PUBLIC Execute : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CurrentStateBufA := E_PackMLStates.Execute;

// IF _PalletDetected AND _DepalletizerReady THEN
//     // Klep naar beneden = pallet doorlaten
//     Klep.SturingOpen(FALSE);
//     // Motor.Start();                         // rollerband aan
//     // _OutputPalletNaarDepallet := TRUE;     // pallet naar depalletizer
//
// ELSIF _PalletDetected AND NOT _DepalletizerReady THEN
//     // Klep omhoog = pallet tegenhouden
//     Klep.SturingOpen(TRUE);
//     // Motor.Stop();                          // rollerband uit
//     // _OutputPalletNaarDepallet := FALSE;
//
// ELSE
//     // Geen pallet → klep naar beneden, band aan, klaar voor nieuwe pallet
//     Klep.SturingOpen(FALSE);
//     // Motor.Start();
//     // _OutputPalletNaarDepallet := FALSE;
// END_IF;

Execute := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Held" Id="{7de6d903-1642-4780-83ef-024fa07c02d4}" FolderPath="Methods\">
      <Declaration><![CDATA[METHOD PUBLIC Held : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CurrentStateBufA := E_PackMLStates.Held;

// Held = pauze actief → alles blijft vastgehouden
// Voor nu (veilig): klep dicht
IF Klep.Status THEN
    Klep.SturingOpen(FALSE);     // FALSE = dicht
END_IF;

// later:
// // Motor.Stop();
// // wacht op Unholding-command van control

Held := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Holding" Id="{f3215803-7556-4f9c-ac5c-659c067ba981}" FolderPath="Methods\">
      <Declaration><![CDATA[METHOD PUBLIC Holding : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CurrentStateBufA := E_PackMLStates.Holding;

// Holding: gecontroleerd pauzeren → klep dicht
Klep.SturingOpen(FALSE);

// Klaar? → Held
IF Klep.Status = FALSE THEN
    _ActiveStateBufA := E_PackMLStates.Held;
END_IF;

// later:
// // Motor.Stop();

Holding := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Idle" Id="{d321b098-3b8d-4f60-b30b-e293959ea482}" FolderPath="Methods\">
      <Declaration><![CDATA[METHOD PUBLIC Idle : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CurrentStateBufA := E_PackMLStates.Idle;

// In Idle: klep moet veilig “dicht” staan (TRUE).
	
IF Klep.Status = FALSE THEN
    Klep.SturingOpen(TRUE);          // klep omhoog / blokkeren
END_IF;

// // Motor.Stop();                  // rollerband uit
// // _OutputPalletNaarDepallet := FALSE;

Idle := TRUE;
]]></ST>
      </Implementation>
    </Method>
