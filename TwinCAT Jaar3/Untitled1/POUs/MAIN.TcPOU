<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="MAIN" Id="{69f3564d-4b0f-48c8-af69-b703e93ec4b9}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
VAR
	Depalletizer : FB_Depalletizer_1;
	
	Vacuumzuignap : FB_Vacuumzuignap;
	
	MotorSchuif : FB_Motorschuif;
	
	Druksensor : FB_Druksensor;
	//h
	
	ControlWes : ControlTestWESSE;
	
	Klep : FB_Klep;
	
	    TestClk : BOOL;      // testbool
    Klep1   : FB_Klep;   // unit
    BufferA : FB_BufferA; // equipment
	 
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Depalletizer.Schuif := MotorSchuif;
Depalletizer.Zuignap1 := Vacuumzuignap;
Depalletizer.Zuignap2 := Vacuumzuignap;
Depalletizer.Zuignap3 := Vacuumzuignap;
Depalletizer.Zuignap4 := Vacuumzuignap;
Depalletizer.Druksensor1 := Druksensor;
ControlWes.Depalletizer1 := Depalletizer;
Depalletizer.KlepDepallet := Klep;

Druksensor();
Depalletizer();
MotorSchuif();
Vacuumzuignap();
ControlWes();
Klep();

BufferA(
    klep   := Klep1,   // interface van de unit doorgeven
    i_bClk := TestClk  // command van boven (bijv. via HMI)
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>